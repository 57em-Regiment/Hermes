{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "customConditions": ["import"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@57eme-regiment/auth-browser/dist/*": ["node_modules/@57eme-regiment/auth-package/dist/browser/*"],
      "@57eme-regiment/auth-browser/dist/*": ["node_modules/@57eme-regiment/auth-package/dist/browser/*"],
      "@57eme-regiment/auth-browser/dist/*": ["node_modules/@57eme-regiment/auth-package/dist/browser/*"],
      "@57eme-regiment/auth-contracts": ["node_modules/@57eme-regiment/auth-package/dist/index.d.ts"],
      "@57eme-regiment/auth-browser": ["node_modules/@57eme-regiment/auth-package/dist/browser/index.d.ts"],
      "@/*": ["./src/*"]
    },

    /* Strict */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  }
}
